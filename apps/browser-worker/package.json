{
  "name": "@scrappy/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Playwright browser runner service",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@scrappy/core": "workspace:*",
    "@scrappy/scraping": "workspace:*"
  },
  "devDependencies": {
    "@scrappy/config": "workspace:*",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
