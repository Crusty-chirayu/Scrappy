# ==============================================================================
# @scrappy/api Environment Configuration
# ==============================================================================

# Server port
PORT=4000

# Environment mode: development | test | production
NODE_ENV=development

# Structured logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Public API base URL used for OpenAPI specs and webhook callbacks
API_BASE_URL=http://localhost:4000

# CORS allowed origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string (Supabase / local Docker)
DATABASE_URL=postgresql://scrappy:scrappy_dev@localhost:5432/scrappy

# Direct connection string for pg-boss session connections (port 5432, not transaction pooler)
DATABASE_DIRECT_URL=postgresql://scrappy:scrappy_dev@localhost:5432/scrappy

# JWT secret key for signing workspace API access tokens (min 16 chars)
JWT_SECRET=dev-jwt-secret-min-16-chars-long
