# ==============================================================================
# @scrappy/web Production Environment Variables (e.g. Vercel deployment)
# ==============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://scrappy.in
NEXT_PUBLIC_API_URL=https://api.scrappy.in

# Supabase Client Connectivity
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-Side Only Keys (Next.js Server Actions & Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
AUTH_SECRET=generate-a-secure-random-32-char-string-here

# Mode
INTEGRATION_MODE=live
