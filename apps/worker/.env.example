# ==============================================================================
# @scrappy/worker Environment Configuration
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info

# CRITICAL NOTE ON PG-BOSS + SUPABASE:
# Workers MUST connect via Postgres session mode (port 5432 / direct connection),
# NOT through transaction pooler (port 6543), because pg-boss relies on advisory locks and LISTEN/NOTIFY.
DATABASE_URL=postgresql://scrappy:scrappy_dev@localhost:5432/scrappy

# Maximum concurrent worker jobs
WORKER_CONCURRENCY=5

# Per-host scraping rate limit delay in milliseconds (responsible scraping policy)
SCRAPING_RATE_LIMIT_DELAY_MS=1000

# URL of the isolated Playwright browser-worker service
BROWSER_WORKER_URL=http://localhost:5000
