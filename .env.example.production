# ==============================================================================
# SCRAPPY PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production or input these variables into your hosting
# provider's environment settings (Vercel, Railway, Supabase Cloud, Fly.io).
#
# Rule: Never commit real production secrets to version control.
# Mode Switch: Set INTEGRATION_MODE=live to enable real APIs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & INTEGRATION SWITCH
# ------------------------------------------------------------------------------
NODE_ENV=production
# local = mock adapters, fake AI, recorded fixtures, local Mailpit
# live  = production APIs (Supabase Cloud, Razorpay Live, Resend, Gemini)
INTEGRATION_MODE=live
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. APPLICATION URLS & NETWORKING
# ------------------------------------------------------------------------------
# Public canonical URL for the web app (e.g., https://scrappy.in)
NEXT_PUBLIC_APP_URL=https://scrappy.in

# Public API Gateway URL (e.g., https://api.scrappy.in)
NEXT_PUBLIC_API_URL=https://api.scrappy.in

# Secret for session tokens and encryption (min 32 chars random string)
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-secure-random-32-char-string-here

# JWT Secret for signing API keys and workspace tokens
JWT_SECRET=generate-another-secure-random-32-char-string-here

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Database, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (NEVER expose to browser; server & worker ONLY)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# PostgreSQL Direct Session Connection String (Port 5432, direct connection)
# CRITICAL: pg-boss queue requires direct port 5432 session connection, NOT transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 4. PAYMENT & SUBSCRIPTION BILLING (Razorpay)
# ------------------------------------------------------------------------------
# Obtained from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_actual_webhook_secret

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & ALERTS (Resend)
# ------------------------------------------------------------------------------
# Obtained from: Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_actual_resend_api_key
EMAIL_FROM=alerts@scrappy.in

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE (Google Gemini)
# ------------------------------------------------------------------------------
# Obtained from: Google AI Studio -> Get API Key
# Used for report executive summaries and schema resilience inference
GEMINI_API_KEY=AIzaSy_your_actual_gemini_key

# ------------------------------------------------------------------------------
# 7. OPERATOR SECURITY & ADMIN ALLOWLIST
# ------------------------------------------------------------------------------
# Comma-separated list of operator emails authorized to access @scrappy/admin console
ADMIN_ALLOWED_EMAILS=founder@scrappy.in,ops@scrappy.in

# ------------------------------------------------------------------------------
# 8. SCRAPING ENGINE POLICIES (Worker Only)
# ------------------------------------------------------------------------------
# Per-host delay in milliseconds to respect rate limits and robots.txt
SCRAPING_RATE_LIMIT_DELAY_MS=1500
WORKER_CONCURRENCY=5
