{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@scrappy/core": ["./packages/core/src/index.ts"],
      "@scrappy/core/*": ["./packages/core/src/*"],
      "@scrappy/ui": ["./packages/ui/src/index.ts"],
      "@scrappy/ui/*": ["./packages/ui/src/*"],
      "@scrappy/brand": ["./packages/brand/src/index.ts"],
      "@scrappy/brand/*": ["./packages/brand/src/*"],
      "@scrappy/db": ["./packages/db/src/index.ts"],
      "@scrappy/db/*": ["./packages/db/src/*"],
      "@scrappy/scraping": ["./packages/scraping/src/index.ts"],
      "@scrappy/scraping/*": ["./packages/scraping/src/*"],
      "@scrappy/adapters": ["./packages/adapters/src/index.ts"],
      "@scrappy/adapters/*": ["./packages/adapters/src/*"],
      "@scrappy/adapter-amazon-in": ["./packages/adapters/amazon-in/src/index.ts"],
      "@scrappy/adapter-flipkart": ["./packages/adapters/flipkart/src/index.ts"],
      "@scrappy/adapter-croma": ["./packages/adapters/croma/src/index.ts"],
      "@scrappy/adapter-reliance-digital": ["./packages/adapters/reliance-digital/src/index.ts"],
      "@scrappy/matching": ["./packages/matching/src/index.ts"],
      "@scrappy/matching/*": ["./packages/matching/src/*"],
      "@scrappy/pricing": ["./packages/pricing/src/index.ts"],
      "@scrappy/pricing/*": ["./packages/pricing/src/*"],
      "@scrappy/ai": ["./packages/ai/src/index.ts"],
      "@scrappy/ai/*": ["./packages/ai/src/*"]
    }
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.tsx",
    "apps/**/src/**/*.ts",
    "apps/**/src/**/*.tsx",
    "vitest.workspace.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
